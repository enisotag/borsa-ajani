# Google AI Studio (Ücretsiz API Anahtarı: https://aistudio.google.com/apikey)
GEMINI_API_KEY=buraya_gemini_api_anahtarinizi_yazin
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Yedek Ücretsiz LLM: Groq (Opsiyonel, kredi kartı istemez: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Telegram Bot Ayarları (@BotFather üzerinden alınır)
TELEGRAM_BOT_TOKEN=buraya_telegram_bot_tokeninizi_yazin
# Bildirimlerin gideceği Chat ID (Bota /start yazdıktan sonra loglarda veya @userinfobot ile görebilirsiniz)
TELEGRAM_CHAT_ID=buraya_telegram_chat_id_yazin

# Fırsat Radarı Filtre Eşikleri (Portföy dışındaki hisseler için)
MIN_UPSIDE_PERCENT=35.0
MIN_BUY_COUNT=2

# Zamanlayıcı Ayarları
MORNING_REPORT_TIME=09:30
DAILY_REPORT_TIME=18:30
SCAN_INTERVAL_MINUTES=30
TIMEZONE=Europe/Istanbul

# Veritabanı Yolu
DB_PATH=data/borsa_ajani.db

# Portföy Kalıcılığı (Opsiyonel - Bulut/Render kurulumları için)
# Format: HISSE:LOT:MALIYET veya sadece izleme için HISSE (virgülle ayırın)
# Örnek: INITIAL_PORTFOLIO=THYAO:100:285,TUPRS:50:162.5,ASELS
INITIAL_PORTFOLIO=
# GitHub üzerinden otomatik portföy yedekleme ve geri yükleme (Contents Read/Write token)
GITHUB_TOKEN=
GITHUB_REPO=enisotag/borsa-ajani
GITHUB_PORTFOLIO_PATH=data/portfolio_backup.json
